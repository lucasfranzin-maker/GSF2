# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=gsf_database

# Comma-separated list of allowed frontend origins (no wildcard in production)
CORS_ORIGINS=http://localhost:3000

# Resend (transactional email for the contact form)
RESEND_API_KEY=re_your_resend_api_key
SENDER_EMAIL=onboarding@resend.dev
# Initial contact-form recipient. This only seeds the DB-stored setting on
# first startup - afterwards it can be changed from the /admin settings page
# without redeploying.
CONTACT_RECIPIENT=lucas.franzin@googlemail.com

# Admin access. Required - there is no built-in default. Use a long random
# string (e.g. `openssl rand -hex 32`). Admin endpoints return 503 until this
# is set.
ADMIN_TOKEN=change-me-to-a-long-random-string
# How long an admin session (issued at /admin/login) stays valid, in seconds.
ADMIN_SESSION_TTL_SECONDS=28800

# Contact-form spam protection (in-memory per process; fine for a single
# backend instance).
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=600
